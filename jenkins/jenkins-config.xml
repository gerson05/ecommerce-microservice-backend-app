<?xml version='1.1' encoding='UTF-8'?>
<jenkins>
  <disabledAdministrativeMonitors/>
  <version>2.401.3</version>
  <numExecutors>4</numExecutors>
  <mode>NORMAL</mode>
  <useSecurity>true</useSecurity>
  <authorizationStrategy class="hudson.security.AuthorizationStrategy$Unsecured"/>
  <securityRealm class="hudson.security.SecurityRealm$None"/>
  <disableRememberMe>false</disableRememberMe>
  <projectNamingStrategy class="jenkins.model.ProjectNamingStrategy$DefaultProjectNamingStrategy"/>
  <workspaceDir>${JENKINS_HOME}/workspace/${ITEM_FULL_NAME}</workspaceDir>
  <buildsDir>${ITEM_ROOTDIR}/builds</buildsDir>
  <markupFormatter class="hudson.markup.RawHtmlMarkupFormatter" plugin="antisamy-markup-formatter@3.0.0">
    <disableSyntaxHighlighting>false</disableSyntaxHighlighting>
  </markupFormatter>
  <jdks/>
  <viewsTabBar class="hudson.views.DefaultViewsTabBar"/>
  <myViewsTabBar class="hudson.views.DefaultMyViewsTabBar"/>
  <clouds/>
  <scmCheckoutRetryCount>0</scmCheckoutRetryCount>
  <views>
    <hudson.model.AllView>
      <owner class="hudson" reference="../../.."/>
      <name>all</name>
      <filterExecutors>false</filterExecutors>
      <filterQueue>false</filterQueue>
      <properties class="hudson.model.View$PropertyList"/>
    </hudson.model.AllView>
  </views>
  <primaryView>all</primaryView>
  <slaveAgentPort>50000</slaveAgentPort>
  <label></label>
  <nodeProperties/>
  <globalNodeProperties/>
  <scmCheckoutRetryCount>0</scmCheckoutRetryCount>
  <globalBuildDiscarders>
    <hudson.tasks.LogRotator>
      <daysToKeep>30</daysToKeep>
      <numToKeep>50</numToKeep>
      <artifactDaysToKeep>7</artifactDaysToKeep>
      <artifactNumToKeep>10</artifactNumToKeep>
    </hudson.tasks.LogRotator>
  </globalBuildDiscarders>
  <systemMessage></systemMessage>
  <globalJobProperties/>
  <mailer plugin="mailer@1.34">
    <smtpServer>smtp.gmail.com</smtpServer>
    <smtpPort>587</smtpPort>
    <useSsl>true</useSsl>
    <useTls>true</useTls>
    <charset>UTF-8</charset>
  </mailer>
  <jenkinsURL>http://localhost:8080/</jenkinsURL>
  <installStateName>RUNNING</installStateName>
  <installStateMessage></installStateMessage>
  <installStatePluginVersion></installStatePluginVersion>
  <installStateComplete>true</installStateComplete>
</jenkins>







